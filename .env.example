# ACE settings template.
#
# Copy this file to `.env.local` (same folder) and fill in your own values.
# `.env.local` is ignored by git and must NEVER be committed, emailed or pasted into chat.
# Live (production) values are set in the hosting dashboard, not in a file.

# ---------- Database (Supabase: Project Settings > Database > Connection string) ----------
# The running apps use the POOLED connection (port 6543).
DATABASE_URL=
# Migrations use the DIRECT / session connection (port 5432).
DIRECT_URL=
# The client portal's own low-privilege database login (role "ace_portal", created by a migration with
# no password). LIVE ONLY: the owner sets its password in the database, then puts the connection string
# here in the hosting dashboard. In production the portal refuses to start without it. In development it
# falls back to DATABASE_URL.
PORTAL_DATABASE_URL=

# ---------- Supabase sign-in (Project Settings > API Keys) ----------
# Public by design (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Anyone holding this can bypass every rule. Never expose it.
# (Newer Supabase projects call these the "publishable" and "secret" keys.)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="ACE Garden Services <noreply@acegardens.co.za>"

# ---------- Where each app lives ----------
ADMIN_URL=http://localhost:3100
PORTAL_URL=http://localhost:3200
