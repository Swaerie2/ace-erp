// ACE Garden Services: core database schema.
//
// Modules 0 to 5a: organisation settings, staff users, audit log, customers, contacts, properties,
// services, quotes, client link, client portal, invoices, payments. Jobs arrive in Module 6, and so on.
//
// Rules for every future model:
//   * Money is stored as whole cents (Int), never floats.
//   * Tables are private by default: Row Level Security is enabled in the migration,
//     so the public database API can never read them. Only our server code can.
//   * Changes to important records are written to AuditLog.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  MANAGER
  CREW
}

enum AuditActorType {
  STAFF
  CUSTOMER
  SYSTEM
}

/// Exactly one row (id = "singleton"). Business-wide settings.
model OrganisationSettings {
  id            String   @id @default("singleton")
  tradingName   String
  legalName     String
  currency      String   @default("ZAR")
  /// ACE is not VAT registered. The switch exists so VAT can be turned on later
  /// without rebuilding anything. While false, no VAT appears anywhere.
  vatEnabled    Boolean  @default(false)
  /// VAT rate in basis points (1500 = 15%). Ignored while vatEnabled is false.
  vatRateBps    Int      @default(0)
  quotePrefix   String   @default("Q")
  invoicePrefix String   @default("INV")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organisation_settings")
}

/// A person who can sign in to the staff app.
/// `id` is the same value as the user's id in the sign-in system, so the two always match.
model StaffUser {
  id          String    @id @db.Uuid
  email       String    @unique
  name        String
  role        StaffRole
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@map("staff_users")
}

/// Append-only record of who did what. Never updated, never deleted.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  at         DateTime       @default(now())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([at])
  @@map("audit_log")
}

enum CustomerType {
  PERSON
  COMPANY
}

enum CustomerStatus {
  LEAD
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CustomerSource {
  REFERRAL
  GOOGLE
  FACEBOOK
  DIRECTORY
  OTHER
}

enum ServiceFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  ONCE_OFF
}

/// Module 5: when a monthly client is billed. PRE: the run in month M bills service month M+1, due the last
/// day of M. POST: the run in month M bills service month M, due the 25th of M.
enum BillingTiming {
  PRE
  POST
}

/// The account quotes and invoices go to. Archived, never deleted.
model Customer {
  id                  String          @id @default(uuid()) @db.Uuid
  /// Shown as C-0001. A database sequence, so numbers are never reused.
  number              Int             @unique @default(autoincrement())
  type                CustomerType
  displayName         String
  companyName         String?
  registrationNumber  String?
  status              CustomerStatus  @default(ACTIVE)
  /// Remembered so "restore" returns the customer to where it was.
  statusBeforeArchive CustomerStatus?
  billingLine1        String?
  billingLine2        String?
  billingSuburb       String?
  billingCity         String?
  billingPostalCode   String?
  source              CustomerSource?
  sourceNote          String?
  /// Internal only. Never shown to crew or in the client portal.
  notes               String?
  /// POPIA: when and how they agreed to us holding their details.
  consentAt           DateTime?
  consentSource       String?
  consentNote         String?
  /// Module 4: the managing agency of this complex (an ordinary customer). One level only. Cleared on anonymise.
  managedById         String?         @db.Uuid
  /// Module 4: while managed, true = bills go to the agency, false = to the complex itself.
  billsToManager      Boolean         @default(true)
  /// Module 5: Pre or Post billing for the monthly run. Default Pre for every customer.
  billingTiming       BillingTiming   @default(PRE)
  archivedAt          DateTime?
  anonymisedAt        DateTime?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  contacts   Contact[]
  properties Property[]
  quotes     Quote[]

  managedBy        Customer?  @relation("CustomerManagement", fields: [managedById], references: [id], onDelete: Restrict)
  managedCustomers Customer[] @relation("CustomerManagement")

  invoices       Invoice[] @relation("InvoiceCustomer")
  billedInvoices Invoice[] @relation("InvoiceBillTo")
  payments       Payment[]

  @@index([displayName])
  @@index([status])
  @@index([managedById])
  @@map("customers")
}

/// A person at a customer (owner, trustee, managing agent, tenant...).
model Contact {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @db.Uuid
  name             String
  role             String?
  /// Always lowercase (database constraint).
  email            String?
  /// Always +27 format.
  phone            String?
  receivesQuotes   Boolean  @default(true)
  receivesInvoices Boolean  @default(true)
  /// Module 4: this contact's email becomes a client-portal login.
  portalAccess     Boolean  @default(false)
  /// Module 4: when portal access was first given (kept after removal, so access is never silently re-granted).
  portalInvitedAt  DateTime?
  /// Module 4: when this person completed the portal welcome page.
  portalWelcomedAt DateTime?
  /// Module 4: last successful portal sign-in.
  lastSignedInAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  acceptedQuotes Quote[] @relation("QuoteAcceptedByContact")
  paymentReports PaymentReport[]

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@map("contacts")
}

/// A place where work happens. A customer can have several.
model Property {
  id            String            @id @default(uuid()) @db.Uuid
  customerId    String            @db.Uuid
  label         String
  addressLine1  String
  addressLine2  String?
  suburb        String?
  city          String?
  postalCode    String?
  mapUrl        String?
  /// Gate codes, dogs, who to call. Staff only, never shown to clients.
  accessNotes   String?
  lawnSizeSqm   Int?
  grassType     String?
  hasIrrigation Boolean           @default(false)
  terrainNotes  String?
  frequency     ServiceFrequency?
  preferredDay  String?
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  quotes   Quote[]

  invoiceLines InvoiceLine[]

  @@index([customerId])
  @@map("properties")
}

enum ServiceKind {
  CORE
  OPTIONAL_EXTRA
}

/// A service ACE sells. There are no prices here: every client is quoted after a site visit
/// (Module 3). Switched off by setting archivedAt, never deleted, so old quotes keep their wording.
model Service {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String
  kind        ServiceKind @default(CORE)
  /// Display order on quotes. Ties (two added at the same moment) are broken by createdAt, then id.
  sortOrder   Int
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  scopeItems QuoteScopeItem[]

  @@index([sortOrder])
  @@map("services")
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  REPLACED
  WITHDRAWN
}

enum QuoteLineKind {
  PRICED
  OPTIONAL
  INCLUDED
}

enum QuoteBilling {
  MONTHLY
  ONCE_OFF
}

enum QuoteFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  AS_REQUIRED
}

enum QuoteSentMethod {
  WHATSAPP
  EMAIL
  HAND
  OTHER
}

enum QuoteAcceptMethod {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  SIGNED_COPY
  CLIENT_LINK
  CLIENT_PORTAL
}

/// Exactly one row (id = "singleton"). The standard wording printed on quotes. Edited by the owner;
/// each issued quote keeps its own frozen copy (Quote.wordingSnapshot).
model QuoteWording {
  id                  String   @id @default("singleton")
  tagline             String
  /// string[]
  standardExclusions  Json
  /// { heading: string, body: string }[]
  monthlyTerms        Json
  onceOffTerms        Json
  commonTerms         Json
  /// string[]
  everyVisitPoints    Json
  defaultValidityDays Int      @default(30)
  registrationNumber  String
  phone               String
  email               String
  website             String
  updatedById         String?
  updatedAt           DateTime @updatedAt

  @@map("quote_wording")
}

/// A quote for one customer and one property. Drafts have no number; issuing freezes the content.
model Quote {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String             @db.Uuid
  propertyId            String             @db.Uuid
  status                QuoteStatus        @default(DRAFT)
  /// QUO-<numberYear>-<numberSeq>, null while a draft. A revision keeps the number and raises `revision`.
  numberYear            Int?
  numberSeq             Int?
  revision              Int                @default(1)
  revisionOfId          String?            @db.Uuid
  /// Raised on every draft save; guards against two devices editing one draft.
  draftVersion          Int                @default(1)
  validUntil            DateTime           @db.Date
  /// Staff only. Personal data: scrubbed on anonymise.
  internalNote          String?
  createdById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  issuedAt              DateTime?
  issuedById            String?
  sentAt                DateTime?
  sentMethod            QuoteSentMethod?
  /// The next five are frozen at issue and are personal data.
  recipientName         String?
  recipientEmail        String?
  recipientPhone        String?
  siteLabel             String?
  siteAddress           String?
  /// Frozen wording (tagline, exclusions, the terms that apply, every-visit points, business details).
  wordingSnapshot       Json?
  /// SHA-256 of the canonical content at issue: proves exactly what was accepted.
  contentHash           String?
  acceptedAt            DateTime?
  acceptedMethod        QuoteAcceptMethod?
  acceptedByName        String?
  acceptedStartDate     DateTime?          @db.Date
  acceptanceNote        String?
  acceptedByStaffId     String?
  acceptedIp            String?
  acceptedUserAgent     String?
  declinedAt            DateTime?
  declineReason         String?
  withdrawnAt           DateTime?
  reversedAt            DateTime?
  reversalNote          String?
  /// Set when a later accepted monthly quote replaced this one as the property's agreement.
  agreementEndedAt      DateTime?
  agreementReplacedById String?            @db.Uuid
  /// The private client link code (base64url, 43 chars). Null = no link. A secret: scrubbed on anonymise.
  linkToken             String?            @unique
  linkCreatedAt         DateTime?
  firstViewedAt         DateTime?
  lastViewedAt          DateTime?
  /// True when the decline came from the client link rather than from staff.
  declinedByClient      Boolean            @default(false)
  /// Module 4: the signed-in contact who accepted in the portal. The agency is implied when that contact's
  /// customer is not the quote's customer.
  acceptedByContactId   String?            @db.Uuid

  customer   Customer         @relation(fields: [customerId], references: [id])
  property   Property         @relation(fields: [propertyId], references: [id])
  revisionOf Quote?           @relation("QuoteRevisions", fields: [revisionOfId], references: [id])
  revisions  Quote[]          @relation("QuoteRevisions")
  scopeItems QuoteScopeItem[]
  lines      QuoteLine[]

  acceptedByContact Contact? @relation("QuoteAcceptedByContact", fields: [acceptedByContactId], references: [id], onDelete: SetNull)
  invoices          Invoice[]

  @@unique([numberYear, numberSeq, revision])
  @@index([customerId])
  @@index([propertyId])
  @@index([status])
  @@map("quotes")
}

/// One catalogue service on a quote: included or not, with its own copy of the wording.
model QuoteScopeItem {
  id          String      @id @default(uuid()) @db.Uuid
  quoteId     String      @db.Uuid
  serviceId   String      @db.Uuid
  sortOrder   Int
  included    Boolean     @default(false)
  name        String
  description String
  kind        ServiceKind

  quote   Quote   @relation(fields: [quoteId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([quoteId, serviceId])
  @@index([quoteId])
  @@map("quote_scope_items")
}

/// One price line. PRICED lines are in the totals, OPTIONAL lines are the client's choice,
/// INCLUDED lines have no charge.
model QuoteLine {
  id          String          @id @default(uuid()) @db.Uuid
  quoteId     String          @db.Uuid
  sortOrder   Int
  lineKind    QuoteLineKind
  /// Empty for INCLUDED lines.
  billing     QuoteBilling?
  /// How often the visits are (MONTHLY billing) or AS_REQUIRED for add-ons.
  frequency   QuoteFrequency?
  description String
  /// Whole cents, above zero for PRICED and OPTIONAL; empty for INCLUDED.
  amountCents Int?
  /// Set on acceptance: did the client take this optional add-on.
  chosen      Boolean         @default(false)

  quote Quote @relation(fields: [quoteId], references: [id])

  invoiceLines InvoiceLine[]

  @@index([quoteId])
  @@map("quote_lines")
}

/// The last quote number given out in each year (South African year). Taken with one atomic statement.
model QuoteCounter {
  year    Int @id
  lastSeq Int

  @@map("quote_counters")
}

/// Rate limiting for the public client link. One row per (bucket, 10-minute window). The bucket holds a
/// HASHED visitor address, never the address itself.
model PublicLinkHit {
  bucket      String
  windowStart DateTime
  count       Int

  @@id([bucket, windowStart])
  @@map("public_link_hits")
}

/// Module 4: one-time sign-in codes for the client portal. Only a salted hash of the code is stored.
/// `email` is personal data: rows are deleted when access is removed or the customer is anonymised.
model PortalCode {
  id        String    @id @default(uuid()) @db.Uuid
  /// Lowercase (database constraint).
  email     String
  codeHash  String
  salt      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("portal_codes")
}

/// Module 4: signed-in portal sessions. Only the SHA-256 of the random cookie value is stored.
/// `email` is personal data: rows are deleted on sign out, access removal and anonymise.
model PortalSession {
  id                String   @id @default(uuid()) @db.Uuid
  tokenHash         String   @unique
  /// Lowercase (database constraint).
  email             String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime
  /// Sliding: 30 days after the last use, never past absoluteExpiresAt.
  expiresAt         DateTime
  /// 90 days after sign-in.
  absoluteExpiresAt DateTime

  @@index([email])
  @@map("portal_sessions")
}

enum InvoiceKind {
  MONTHLY
  ONCE_OFF
}

/// Only these three are stored. Unpaid, part paid, paid and overdue are worked out from the balance.
enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum InvoiceLineKind {
  SERVICE
  OPTIONAL
  LATE_FEE
  ADJUSTMENT
  ONCE_OFF
}

enum InvoiceEmailStatus {
  NONE
  SENT
  FAILED
}

enum PaymentReportStatus {
  WAITING
  CONFIRMED
  DISMISSED
}

/// Module 5: exactly one row (id = "singleton"), edited by the owner. Issued invoices keep their own frozen
/// copy of the bank details (Invoice.bankSnapshot). Bank details start empty: issuing is refused until set.
model InvoiceSettings {
  id             String   @id @default("singleton")
  bankName       String   @default("")
  accountHolder  String   @default("")
  accountNumber  String   @default("")
  branchCode     String   @default("")
  accountType    String   @default("")
  /// Once-off invoices: due this many days after the issue date unless staff set a due date.
  onceOffDueDays Int      @default(14)
  /// The suggested late payment fee in whole cents (0 = no suggestion).
  lateFeeCents   Int      @default(10000)
  updatedAt      DateTime @updatedAt
  updatedById    String?

  @@map("invoice_settings")
}

/// Module 5: the last invoice number given out in each year (South African year). Taken with one atomic statement.
model InvoiceCounter {
  year    Int @id
  lastSeq Int

  @@map("invoice_counters")
}

/// Module 5: one invoice. `customerId` is the client the work is for, `billToCustomerId` the payer (the agency
/// when the complex's bills go to it). Drafts have no number; issuing freezes the recipient, bank details and total.
/// The partial unique index invoices_monthly_once_per_month ("customerId", "serviceMonth") WHERE kind = 'MONTHLY'
/// AND status <> 'VOID' exists only in the SQL migration (Prisma cannot express it), as do the CHECK constraints.
/// Any generated migration diff that tries to DROP that index must have the DROP stripped before it is applied.
model Invoice {
  id               String             @id @default(uuid()) @db.Uuid
  customerId       String             @db.Uuid
  billToCustomerId String             @db.Uuid
  kind             InvoiceKind
  /// First day of the month the service is for. Monthly invoices only.
  serviceMonth     DateTime?          @db.Date
  status           InvoiceStatus      @default(DRAFT)
  /// INV-<numberYear>-<numberSeq>, null while a draft.
  numberYear       Int?
  numberSeq        Int?
  dueDate          DateTime?          @db.Date
  issuedAt         DateTime?
  issuedById       String?
  createdAt        DateTime           @default(now())
  createdById      String?
  /// Raised on every draft save; guards against two devices editing one draft.
  draftVersion     Int                @default(1)
  sourceQuoteId    String?            @db.Uuid
  /// Set at issue: the sum of the line amounts.
  totalCents       Int?
  /// Frozen at issue. Personal data: scrubbed on anonymise.
  recipientName    String?
  recipientAddress String?
  /// Frozen at issue: { bank, business, paymentReference }. ACE's own details only.
  bankSnapshot     Json?
  /// SHA-256 of the canonical content at issue.
  contentHash      String?
  emailStatus      InvoiceEmailStatus @default(NONE)
  emailedAt        DateTime?
  voidedAt         DateTime?
  /// Typed by staff. Scrubbed on anonymise.
  voidReason       String?
  voidedById       String?

  customer     Customer            @relation("InvoiceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  billTo       Customer            @relation("InvoiceBillTo", fields: [billToCustomerId], references: [id], onDelete: Restrict)
  sourceQuote  Quote?              @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]       @relation("InvoiceLines")
  lateFeeLines InvoiceLine[]       @relation("LateFeeFor")
  allocations  PaymentAllocation[]
  reports      PaymentReport[]

  @@unique([numberYear, numberSeq])
  @@index([customerId])
  @@index([billToCustomerId])
  @@index([status])
  @@map("invoices")
}

/// Module 5: one line of an invoice. Amounts are whole cents and never zero; only ADJUSTMENT may be negative.
model InvoiceLine {
  id                String          @id @default(uuid()) @db.Uuid
  invoiceId         String          @db.Uuid
  sortOrder         Int
  propertyId        String?         @db.Uuid
  kind              InvoiceLineKind
  /// Replaced by a fixed word per kind on anonymise (run lines carry the property label).
  description       String
  amountCents       Int
  sourceQuoteLineId String?         @db.Uuid
  /// LATE_FEE lines: the overdue invoice the fee is charged against.
  forInvoiceId      String?         @db.Uuid

  invoice         Invoice    @relation("InvoiceLines", fields: [invoiceId], references: [id], onDelete: Restrict)
  property        Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sourceQuoteLine QuoteLine? @relation(fields: [sourceQuoteLineId], references: [id], onDelete: SetNull)
  forInvoice      Invoice?   @relation("LateFeeFor", fields: [forInvoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([forInvoiceId])
  @@map("invoice_lines")
}

/// Module 5: money received by EFT. A voided payment keeps its allocation rows as history; they stop counting.
model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  payerCustomerId String    @db.Uuid
  receivedOn      DateTime  @db.Date
  amountCents     Int
  /// The bank reference as typed by staff. Scrubbed on anonymise.
  reference       String?
  /// Scrubbed on anonymise.
  note            String?
  recordedById    String
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?

  payer       Customer            @relation(fields: [payerCustomerId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([payerCustomerId])
  @@map("payments")
}

/// Module 5: part (or all) of a payment applied to one invoice.
model PaymentAllocation {
  id          String @id @default(uuid()) @db.Uuid
  paymentId   String @db.Uuid
  invoiceId   String @db.Uuid
  amountCents Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Module 5: a client's "I have paid" (written by the portal in stage 5b; staff confirm or dismiss).
model PaymentReport {
  id                  String              @id @default(uuid()) @db.Uuid
  invoiceId           String              @db.Uuid
  reportedByContactId String?             @db.Uuid
  paidOn              DateTime            @db.Date
  /// The client's bank reference as typed. Personal data: scrubbed on anonymise.
  reference           String?
  status              PaymentReportStatus @default(WAITING)
  createdAt           DateTime            @default(now())
  resolvedAt          DateTime?
  resolvedById        String?

  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reportedByContact Contact? @relation(fields: [reportedByContactId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@map("payment_reports")
}
